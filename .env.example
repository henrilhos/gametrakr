# When adding additional environment variables, the schema in "/src/env.mjs"
# should be updated accordingly.

# Drizzle
DATABASE_URL='postgresql://crash_bandicoot:12345678@localhost:5432/gametrakr'

# Local development
# `true` replaces Resend, UploadThing, Upstash, and Vercel Analytics with local
# adapters. IGDB/Twitch and the Dub metadata lookup remain remote.
LOCAL_DEV="true"
NEXT_PUBLIC_LOCAL_DEV="true"
LOCAL_REDIS_URL="redis://localhost:6379"

# Next Auth
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Resend
# https://resend.com/docs/introduction
# Not required when LOCAL_DEV=true; Mailpit receives mail at http://localhost:8025.
RESEND_API_KEY="YOUR_RESEND_API_KEY_HERE"
RESEND_EMAIL="YOUR_RESEND_EMAIL_HERE"

# IGDB
# Required in local development because game search continues to use IGDB.
TWITCH_CLIENT_ID="YOUR_TWITCH_CLIENT_ID_HERE"
TWITCH_SECRET_ID="YOUR_TWITCH_SECRET_ID_HERE"

# Uploadthing
# Get your v7 token from the dashboard under API Keys > V7 tab.
# Not required when LOCAL_DEV=true; uploads are written to .local/uploads.
UPLOADTHING_TOKEN="YOUR_UPLOADTHING_TOKEN_HERE"
